{
  "name": "@gamecult/norn-viewer",
  "version": "0.1.0",
  "type": "module",
  "description": "React graph viewer for Epiphany typed graph state.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "tsup src/index.ts --format \"esm,cjs\" --dts --external react --external react-dom --clean",
    "build:demo": "vite build --outDir dist/demo",
    "build:solver:wasm": "powershell -ExecutionPolicy Bypass -File ./scripts/Build-RustSolverWasm.ps1",
    "typecheck": "tsc --noEmit",
    "tune:simulation": "node ./scripts/tune-simulation-profile.mjs",
    "profile:solver": "node ./scripts/profile-rust-solver-performance.mjs",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
